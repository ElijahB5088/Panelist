NEXTPANEL_HOST=0.0.0.0
NEXTPANEL_PORT=8080
NEXTPANEL_SECRET_KEY=change-me-in-production
CREDENTIAL_ENCRYPTION_KEY=replace-with-32-byte-base64-fernet-key
DATABASE_URL=sqlite:///data/nextpanel.db
SYNC_INTERVAL_MINUTES=60
COMICVINE_API_KEY=
