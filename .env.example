METADATA_CACHE_TTL_SECONDS=900
METADATA_CACHE_MAX_ENTRIES=256
METADATA_UPSTREAM_INTERVAL_SECONDS=1
METADATA_CLIENT_WINDOW_SECONDS=60
METADATA_CLIENT_MAX_REQUESTS=30
